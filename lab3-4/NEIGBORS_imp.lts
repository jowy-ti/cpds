const False = 0
const True = 1
range Bool = False..True
set BoolActions = {setTrue, setFalse, [False], [True]}

range Card = 1..2
set CardActions = {set1, set2, [1], [2]}

BOOLVAR = VAL[False],
VAL[v:Bool] = (setTrue -> VAL[True]
			|setFalse -> VAL[False]
			|[v] -> VAL[v]
			).

||FLAGS = (flag1:BOOLVAR || flag2:BOOLVAR).

CARDVAR = CVAL[1],
CVAL[i:Card] = ( set1 -> CVAL[1]
			|set2 -> CVAL[2]
			|[i] -> CVAL[i]
			).

||TURNVAR = (turn:CARDVAR).

NEIGHBOR1 = (flag1.setTrue -> turn.set2 -> TEST),
TEST = (flag2[raised:Bool] -> turn[t:Card] ->
			if (raised && (t == 2)) then TEST
			else (enter -> leaves -> flag1.setFalse -> NEIGHBOR1)
		) + {{flag1,flag2}.BoolActions, {turn}.CardActions}.

NEIGHBOR2 = (flag2.setTrue -> turn.set1 -> TEST),
TEST = (flag1[raised:Bool] -> turn[t:Card] ->
			if (raised && (t == 1)) then TEST
			else (enter -> leaves -> flag2.setFalse -> NEIGHBOR2)
		 ) + {{flag1,flag2}.BoolActions, {turn}.CardActions}.

property MUTEX = ( n1.enter -> n1.leaves -> MUTEX
                 | n2.enter -> n2.leaves -> MUTEX ).

progress ENTER1 = {n1.enter}
progress ENTER2 = {n2.enter}

||FIELD = (n1:NEIGHBOR1 || n2:NEIGHBOR2 || {n1,n2}::FLAGS || {n1,n2}::TURNVAR || MUTEX).

||GREEDY = FIELD << {n1.enter}.
